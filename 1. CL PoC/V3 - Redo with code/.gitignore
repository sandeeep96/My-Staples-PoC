# Staples Category-Level PoC (V3) - files git should skip.
# Everything listed here is regenerated by the pipeline scripts or is local/temporary.

# --- Python / tooling ---------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# --- Method V heavy artefacts (regenerated by method_v_vector.py, ~8 min) ---------------
# Qdrant vector DB (~125 MB) and the saved node vectors (~44 MB).
# Note: run_framework.py needs vectors_V.npz, so after a fresh clone run method_v_vector.py first.
Outputs_v3/V/qdrant_db/
Outputs_v3/V/vectors_V.npz
# per-competitor copies of node_scores_V.csv (the combined file is kept)
Outputs_v3/V/node_scores_V_*.csv

# --- Method G graph exports (regenerated by method_g_graph.py, ~1 min) -------------------
# GraphML (~11 MB) and Neo4j bulk-load CSVs (~6.5 MB); the .cypher scripts are kept.
Outputs_v3/G/category_graph.graphml
Outputs_v3/G/neo4j/nodes.csv
Outputs_v3/G/neo4j/edges.csv

# --- V2 graph exports (unused by V3; already in git history under "V2 - with all 5 Competitors") ---
# V2 tables the V2-vs-V3 comparison reads (Outputs/final/units_all.csv, summary.json) stay tracked.
Outputs/G/category_graph.graphml
Outputs/G/neo4j/nodes.csv
Outputs/G/neo4j/edges.csv

# --- run logs and one-off working files ------------------------------------------------
Outputs_v3/log_*.txt
*.log
Outputs_v3/verify_round4_todo.csv
Outputs_v3/kappa_sample_key.csv

# --- Office / OS temp files -------------------------------------------------------------
~$*
*.tmp
.DS_Store
Thumbs.db
desktop.ini
