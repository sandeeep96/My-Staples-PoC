<div class="sku">
  <div class="comp">
    <div class="who"><span class="dot" style="background:#eb6834"></span>{{ c.comp }} · {{ c.label }}</div>
    <a class="t" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.title }}</a>
    <div class="meta"><b>{{ c.price }}</b> · {{ c.brand }}{% if c.on %} <span class="chip st-PASS">sells on Staples</span>{% endif %}{% if c.house %} <span class="chip">house brand</span>{% endif %}</div>
    <div class="meta">{{ c.colour }} · {{ c.material }} · {{ c.style }} · DFI (Design-Forward Index) {{ c.dfi }}</div>
    {% if c.arch %}<div class="meta">Archetype (Attributes Combination): <b>{{ c.arch.name }}</b> <span class="combo">({{ c.arch.combo }})</span></div>{% endif %}
  </div>
  <div>
    <div class="who"><span class="dot" style="background:#2a78d6"></span>Nearest Staples product</div>
    <a class="t" href="{{ c.st_url }}" target="_blank" rel="noopener">{{ c.st_title }}</a>
    <div class="meta"><b>{{ c.st_price }}</b></div>
    <div class="meta">{{ c.st_colour }} · {{ c.st_material }}</div>
  </div>
  <div class="scores">CRS (Cannibalisation Risk Score) {{ c.crs }} · PPR (Price Position Ratio) {{ c.ppr }}× · AD (Aesthetic Delta) {{ c.ad }}{% if c.m2 %} · Method 2: {{ c.m2 }}{% endif %}{% if c.basis %} · safe under {{ c.basis }}{% endif %}</div>
</div>
