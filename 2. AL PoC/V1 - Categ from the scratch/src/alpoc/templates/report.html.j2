<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root{
  color-scheme: light;
  --bg:#f9f9f7; --surface:#fcfcfb; --surface-2:#f3f2ee; --ink:#0b0b0b; --ink-2:#52514e; --muted:#898781;
  --line:#e1e0d9; --accent:#2a78d6; --comp:#eb6834; --good:#006300; --good-bg:#e6f4e6; --warn-bg:#fdf3dc;
  --bad:#b42f2f; --bad-bg:#fbe9e9; --pend-bg:#ecebe6; --chip:#ecebe6; --ring:rgba(11,11,11,.10);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --bg:#0d0d0d; --surface:#1a1a19; --surface-2:#232321; --ink:#ffffff; --ink-2:#c3c2b7; --muted:#898781;
    --line:#2c2c2a; --accent:#3987e5; --comp:#d95926; --good:#0ca30c; --good-bg:#12301a; --warn-bg:#3a2f12;
    --bad:#e66767; --bad-bg:#3a1a1a; --pend-bg:#2a2a28; --chip:#2a2a28; --ring:rgba(255,255,255,.10);
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0d0d0d; --surface:#1a1a19; --surface-2:#232321; --ink:#ffffff; --ink-2:#c3c2b7; --muted:#898781;
  --line:#2c2c2a; --accent:#3987e5; --comp:#d95926; --good:#0ca30c; --good-bg:#12301a; --warn-bg:#3a2f12;
  --bad:#e66767; --bad-bg:#3a1a1a; --pend-bg:#2a2a28; --chip:#2a2a28; --ring:rgba(255,255,255,.10);
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:14px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--accent)}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px}
header{background:var(--surface);border-bottom:1px solid var(--line)}
header .wrap{padding-top:20px;padding-bottom:0}
h1{font-size:22px;margin:0 0 12px}
nav.tabs{display:flex;gap:4px}
nav.tabs button{font:inherit;font-weight:600;background:none;border:0;border-bottom:3px solid transparent;color:var(--ink-2);
  padding:10px 12px;cursor:pointer}
nav.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
main .wrap{padding-top:22px;padding-bottom:60px}
section.panel[hidden]{display:none}
h2{font-size:18px;margin:30px 0 8px}
h3{font-size:15px;margin:26px 0 6px}
h4{font-size:13.5px;margin:16px 0 4px}
p{margin:6px 0 10px;max-width:820px}
.muted{color:var(--muted)} .ink2{color:var(--ink-2)}
.small{font-size:12.5px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
@media (max-width:820px){.g2{grid-template-columns:1fr}}
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:12.5px}
th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{position:sticky;top:0;background:var(--surface-2);font-weight:600;cursor:pointer;white-space:nowrap;user-select:none}
th.nosort{cursor:default}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
td.key{font-weight:600}
tr:last-child td{border-bottom:0}
.chip{display:inline-block;padding:1px 8px;border-radius:99px;background:var(--chip);font-size:11.5px;white-space:nowrap}
.st-PASS{background:var(--good-bg);color:var(--good)} .st-FAIL{background:var(--bad-bg);color:var(--bad)}
.st-PARTIAL{background:var(--warn-bg)} .st-FILTER{background:var(--warn-bg);color:var(--ink)} .st-PICK{background:var(--good-bg);color:var(--good)} .st-PENDING{background:var(--pend-bg);color:var(--ink-2)}
.fig{background:#fcfcfb;border:1px solid var(--line);border-radius:10px;padding:6px;margin:0}
.fig img{display:block;width:100%;height:auto}
.fig figcaption{font-size:12px;color:#52514e;padding:4px 6px 2px}
.fig.solo{max-width:760px}
.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);
  border-radius:10px;padding:12px 14px;position:sticky;top:0;z-index:5}
.controls label{font-weight:600}
.controls select{font:inherit;padding:7px 10px;border-radius:8px;border:1px solid var(--line);background:var(--surface-2);
  color:var(--ink);max-width:100%;min-width:0;flex:1 1 380px}
.node-head{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:baseline;margin:18px 0 4px}
.node-head h2{margin:0}
dl.facts{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;margin:6px 0 4px;font-size:13.5px;max-width:980px}
dl.facts dt{font-weight:600;color:var(--ink-2)} dl.facts dd{margin:0}
.compname{color:var(--comp)}
dl.insg{display:grid;grid-template-columns:minmax(150px,max-content) 1fr;gap:10px 18px;margin:0}
dl.insg dt{font-weight:600;font-size:13px;padding-top:4px} dl.insg dd{margin:0}
dl.insg dt:not(:first-of-type),dl.insg dt:not(:first-of-type)+dd{border-top:1px solid var(--line);padding-top:10px}
dl.insg ul.ins{margin:0}
@media (max-width:620px){dl.facts,dl.insg{grid-template-columns:1fr} dl.insg dt:not(:first-of-type)+dd{border-top:0;padding-top:0}}
table.grouped tbody{border-top:2px solid var(--line)} table.grouped td.grp{font-weight:600;background:var(--surface-2);min-width:130px}
td.pos{color:var(--comp)} td.neg{color:var(--accent)}
ul.ins{margin:6px 0 0;padding-left:18px} ul.ins li{margin:4px 0}
ol.steps{padding-left:20px;max-width:860px} ol.steps > li{margin:8px 0} ol.steps ul{margin:4px 0;padding-left:18px}
.lede{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:10px;padding:10px 14px;margin:8px 0 12px;max-width:none}
.skugrp{margin:14px 0 20px}
.sku{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface);margin:8px 0}
@media (max-width:620px){.sku{grid-template-columns:1fr}}
.sku > div{padding:10px 12px}
.sku .comp{border-right:1px solid var(--line)}
.sku .who{font-size:11px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--muted);margin-bottom:2px;display:flex;gap:6px;align-items:center}
.sku .dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.sku .t{font-weight:600;font-size:13px;display:block;margin-bottom:4px}
.sku .meta{font-size:12px;color:var(--ink-2)}
.sku .scores{grid-column:1/-1;background:var(--surface-2);font-size:12px;color:var(--ink-2);border-top:1px solid var(--line);padding:6px 12px}
dl.lab{display:grid;grid-template-columns:max-content 1fr;gap:4px 14px;margin:6px 0;font-size:13px}
dl.lab dt{font-weight:600}
dl.lab dd{margin:0;color:var(--ink-2)}
details{margin:8px 0} summary{cursor:pointer;font-weight:600}
.legend-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px;vertical-align:-1px}
/* flow chart */
.fc{display:flex;flex-direction:column;align-items:center;max-width:1000px}
.fc > .fc-step,.fc > .fc-phase{width:min(800px,100%)}
.fc > .fc-fork,.fc > .fc-arrow{width:100%}
.meta{font-size:12px;color:var(--ink-2);margin-top:3px;display:flex;gap:8px;align-items:baseline}
.meta .k{flex:0 0 46px;font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.meta .tech{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:11.5px}
ul.agree{margin:0;padding-left:18px} ul.agree li{margin:3px 0}
.selinfo{margin:10px 0 0} .selinfo ol{margin:6px 0;padding-left:20px;font-size:13px} .selinfo ol li{margin:2px 0}
.yes{color:var(--good);font-weight:600} .no-{color:var(--muted)}
.fc-phase{font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}
.fc-step{display:grid;grid-template-columns:62px minmax(0,1fr);gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
.fc-step.m1{border-left:4px solid var(--accent)} .fc-step.m2{border-left:4px solid var(--comp)}
.fc-tag{font-weight:700;font-size:12px;color:var(--ink-2);background:var(--surface-2);border-radius:8px;display:flex;align-items:center;justify-content:center;text-align:center;padding:4px;min-height:34px;align-self:start}
.fc-step h4{margin:0 0 2px;font-size:14px}
.fc-step p{margin:2px 0 4px;font-size:13px;color:var(--ink-2);max-width:none}
.fc-arrow{height:24px;position:relative}
.fc-arrow::before{content:"";position:absolute;left:50%;top:2px;bottom:7px;border-left:2px solid var(--muted)}
.fc-arrow::after{content:"";position:absolute;left:calc(50% - 5px);bottom:1px;border-left:5px solid transparent;border-right:5px solid transparent;border-top:7px solid var(--muted)}
.fc-fork{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.fc-fork .fc-arrow{grid-column:auto}
.chain{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:6px 0}
.chain .pill{background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:3px 8px;font-size:12.5px}
.chain .to{color:var(--muted);font-size:13px}
.outs{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.o{border-radius:8px;padding:4px 9px;font-size:12px;border:1px solid var(--line)}
.o.ok{background:var(--good-bg)} .o.hold{background:var(--warn-bg)} .o.no{background:var(--bad-bg)}
.o b{font-weight:600}
.planned{display:inline-block;font-size:11px;padding:0 7px;border-radius:99px;border:1px dashed var(--muted);color:var(--ink-2);white-space:nowrap;margin-left:4px}
@media (max-width:720px){.fc-fork{grid-template-columns:1fr}.fc-fork .fc-arrow:nth-child(2){display:none}.fc-step{grid-template-columns:1fr}.fc-tag{justify-content:flex-start}}
footer{color:var(--muted);font-size:12px;padding:30px 0}
@media print{
  header nav, .controls{display:none}
  section.panel[hidden]{display:block}
  .node-sec[hidden]{display:none}
  .node-sec{break-before:page}
}
.combo{color:var(--ink-2);font-size:11.5px}
details.sec{margin:22px 0 6px} details.sec > summary{list-style:none;cursor:pointer}
details.sec > summary::-webkit-details-marker{display:none}
details.sec > summary h3{display:inline;margin:0} details.sec > summary::before{content:"▸ ";color:var(--muted)}
details.sec[open] > summary::before{content:"▾ "} details.sec > summary .hint{font-size:12px;color:var(--muted);font-weight:400;margin-left:6px}
td .combo{display:block;margin-top:1px}
.sel-status{font-size:12px;color:var(--muted)}
.tag-T{display:inline-block;font-size:10.5px;font-weight:700;border-radius:6px;padding:0 5px;background:var(--surface-2);color:var(--ink-2);margin-left:2px}
.pending{background:var(--warn-bg);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin:10px 0}
</style>
</head>
{% macro A(a, bold=True) -%}
{% if bold %}<b>{{ a.name }}</b>{% else %}{{ a.name }}{% endif %}{% if a.combo %} <span class="combo">({{ a.combo }})</span>{% endif %}
{%- endmacro %}
<body>
<header>
  <div class="wrap">
    <h1>{{ title }}</h1>
    <nav class="tabs" role="tablist">
      <button role="tab" data-tab="method" aria-selected="true">Approach &amp; Methodology</button>
      <button role="tab" data-tab="nodes" aria-selected="false">Gaps &amp; Recommendations</button>
    </nav>
  </div>
</header>

<main><div class="wrap">

<!-- ======================================================= TAB 1 -->
<section class="panel" id="tab-method">
  <h2 style="margin-top:0">The question</h2>
  <p>Staples wants to grow its marketplace with <b>core-adjacent</b> products: design and lifestyle extensions of things it already sells (the “White Chair” idea: an aesthetic-first chair next to Staples' ergonomic range), without taking sales from its own first-party assortment. Using only external data, this PoC compares {{ focus|length }} granular Staples nodes, each with its chosen competitor, and asks:</p>
  <ul>
    <li><b>Where are the gaps?</b> Which archetypes (attributes combinations) and attribute values (colour, material, style, features, theme) are more common at the competitor than at Staples, and where do prices differ?</li>
    <li><b>Are they safe and on-brand?</b> Would a product take a sale from a Staples item, does it fit Staples' customer, and is it priced to trade up or to undercut?</li>
    <li><b>What should be added?</b> Named archetypes (attributes combinations) with example products and notes on brands and sellers.</li>
  </ul>

  <h2>The {{ focus|length }} focus nodes</h2>
  <p class="ink2">A node is one exact Staples L3/L4 category. Each node is compared with its Primary 1 competitor. {{ n_scored }} nodes are scored{% if n_thin %}, {{ n_thin }} are thin (descriptive only){% endif %}{% if n_pending %}, and {{ n_pending }} are waiting for competitor data (shown as Staples-only profiles){% endif %}.</p>
  <div class="tbl-wrap"><table><thead><tr><th class="nosort num">#</th><th class="nosort">Segment · play</th><th class="nosort">Staples node (exact path)</th><th class="nosort">Competitor (Primary 1)</th><th class="nosort">Status</th></tr></thead><tbody>
  {% for f in focus %}<tr><td class="num">{{ f.rank }}</td><td>{{ f.segment }}</td><td>{{ f.label }}</td><td><b class="compname">{{ f.comp }}</b>{% if f.status == 'staples_only' %} <span class="muted">(no product data yet)</span>{% endif %}</td><td>{% if f.status == 'scored' %}<span class="chip st-PASS">scored</span>{% elif f.status == 'thin' %}<span class="chip st-PENDING">thin</span>{% else %}<span class="chip st-PARTIAL">competitor data pending</span>{% endif %}</td></tr>{% endfor %}
  </tbody></table></div>
  <p class="muted small">{{ "{:,}".format(n_backlog) }} competitor products were set aside because they belong to other Staples categories (for example calendars, briefcases, standing desks) or were mis-shelved.</p>

  <h2>How we approached it</h2>
  <p>Four phases, nine stages (S0–S8): make the comparison fair, describe every product the same way, score each archetype (attributes combination) two ways, then decide.</p>
  <div class="fc">
    <div class="fc-phase">1 · Make the comparison fair</div>
    <div class="fc-step"><div class="fc-tag">S0</div><div>
      <h4>Ingest &amp; clean</h4>
      <p>Load every retailer's product file, using only the agreed columns, so all later stages read the same fields.</p>
      <div class="chain"><span class="pill">Parse prices &amp; spec sheets</span><span class="to">→</span><span class="pill">Fix garbled text</span><span class="to">→</span><span class="pill">Strip reviews (personal data)</span></div>
      <div class="meta"><span class="k">Output</span>Clean product tables per retailer (no ratings, review counts or ranks used)</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">pandas · PyArrow · ftfy · regex · Python ast</span></div>
    </div></div>
    <div class="fc-arrow"></div>
    <div class="fc-step"><div class="fc-tag">S1</div><div>
      <h4>Product families &amp; nodes</h4>
      <p>Count each product once across colour and size variants, for every retailer, and place Staples families on their node.</p>
      <div class="chain"><span class="pill">Brand + name-stem grouping</span><span class="to">→</span><span class="pill">Colourway count</span><span class="to">→</span><span class="pill">Node = exact Staples L3/L4</span></div>
      <div class="meta"><span class="k">Output</span>Families, colourway counts, the node list</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">pandas · regex name stems · YAML config</span></div>
    </div></div>
    <div class="fc-arrow"></div>
    <div class="fc-step"><div class="fc-tag">S2</div><div>
      <h4>Map competitor products</h4>
      <p>Place each competitor product on its Staples node, or set it aside when it belongs to another category.</p>
      <div class="chain"><span class="pill">Page → node crosswalk</span><span class="to">→</span><span class="pill">Vote of {{ mapping_k }} nearest Staples products (all nodes)</span><span class="to">→</span><span class="pill">Distance check</span></div>
      <div class="outs">
        <span class="o ok"><b>Mapped</b> (≥ {{ "{:.0%}".format(low_conf_prob) }} vote = high confidence)</span>
        <span class="o hold"><b>Close call</b> → LLM adjudication <span class="planned">planned</span></span>
        <span class="o no"><b>Other category / mis-shelved</b> → backlog</span>
      </div>
      <div class="meta"><span class="k">Output</span>Product → node map, backlog for other categories</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">sentence-transformers · {{ encoder }} · similarity-weighted k-NN · Youden's J with a recall floor · Claude Sonnet 5 (planned)</span></div>
    </div></div>

    <div class="fc-arrow"></div>
    <div class="fc-phase">2 · Describe every product the same way</div>
    <div class="fc-step"><div class="fc-tag">S3</div><div>
      <h4>Attributes</h4>
      <p>Extract the same attributes from all of each retailer's text (titles, descriptions, bullets and specifications, uncut), and check the extractor against Staples spec sheets.</p>
      <div class="chain"><span class="pill">Node vocabulary (3 tiers)</span><span class="to">→</span><span class="pill">Same extractor, full text</span><span class="to">→</span><span class="pill">&lt; {{ "{:.0%}".format(cfg.qa.g2_field_acc) }} accurate: excluded</span><span class="to">→</span><span class="pill">{{ m('DFI') }}</span></div>
      <div class="meta"><span class="k">Output</span>Attribute table, DFI (0–1), per-field accuracy</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">closed-vocabulary regex · embedding zero-shot · anchor contrast · Claude Haiku 4.5 Batch API (planned)</span></div>
    </div></div>
    <div class="fc-arrow"></div>
    <div class="fc-step"><div class="fc-tag">S4</div><div>
      <h4>Archetypes (Attributes Combinations)</h4>
      <p>Cut each node into archetypes, each defined by {{ cfg.archetypes.core_facets }} to {{ cfg.archetypes.max_facets }} attributes that mix all three tiers. Attributes on which the two retailers differ most are preferred, and credible tag gaps (e.g. water-resistant) can be attributes too. Price is never an attribute.</p>
      <div class="chain"><span class="pill">Best {{ cfg.archetypes.core_facets }}-attribute combination</span><span class="to">→</span><span class="pill">+5th / 6th where supported</span><span class="to">→</span><span class="pill">&lt; {{ cfg.archetypes.min_pooled }} products: long tail</span><span class="to">→</span><span class="pill">Cluster cross-check</span></div>
      <div class="meta"><span class="k">Output</span>Archetype (Attributes Combination), e.g. “Mid-century velvet chair (Material: velvet · Colour tone: warm-neutral · Form: barrel · Style: mid-century)”</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">combinatorial search · normalised entropy · UMAP · HDBSCAN · {{ m('ARI') }} · bootstrap</span></div>
    </div></div>

    <div class="fc-arrow"></div>
    <div class="fc-phase">3 · Score every archetype (attributes combination), two independent ways</div>
    <div class="fc-fork">
      <div class="fc-step m1"><div class="fc-tag">S5</div><div>
        <h4>Method 1 · vector view → VOS</h4>
        <p>Scores whitespace, fit, look difference and cannibalisation risk for every competitor product.</p>
        <div class="chain"><span class="pill">Standard card → vector</span><span class="to">→</span><span class="pill">VW · AAS · AD · CRS · PPR</span><span class="to">→</span><span class="pill">Label per product</span><span class="to">→</span><span class="pill">Archetype (Attributes Combination) <b>{{ m('VOS') }}</b></span></div>
        <div class="outs"><span class="o ok">CURATE · STYLE-EXT · TRADE-UP</span><span class="o hold">REVIEW · EDGE</span><span class="o no">SUBSTITUTE · UNDERCUT · OFF-BRAND</span></div>
        <div class="meta"><span class="k">Gate</span>Method 1 safety gate on its own product labels → top {{ cfg.gates.method1.top_n }} per node by VOS</div>
        <div class="meta"><span class="k">Output</span>Decision labels, VOS per archetype, Method 1 list</div>
        <div class="meta"><span class="k">Tech</span><span class="tech">{{ encoder }} · NumPy cosine k-NN · logistic regression (scikit-learn) · ROC AUC</span></div>
      </div></div>
      <div class="fc-step m2"><div class="fc-tag">S6</div><div>
        <h4>Method 2 · attribute view → TG</h4>
        <p>Compares each archetype's share, price and attribute mix between the competitor and Staples.</p>
        <div class="chain"><span class="pill">Share per side</span><span class="to">→</span><span class="pill">LSR · PPG · CG · MSG · DFG</span><span class="to">→</span><span class="pill">Percentiles: <b>{{ m('TG') }}</b></span><span class="to">→</span><span class="pill">Attribute twins: <b>{{ m('ACR') }}</b></span></div>
        <div class="meta"><span class="k">Gate</span>Method 2 safety gate: credible over-index + ACR → top {{ cfg.gates.method2.top_n }} per node by TG</div>
        <div class="meta"><span class="k">Output</span>TG per archetype, attribute-value gaps, price view, Method 2 list</div>
        <div class="meta"><span class="k">Tech</span><span class="tech">Jeffreys Beta smoothing · Monte-Carlo credibility · Wasserstein-1 (SciPy) · {{ m('JSD') }}</span></div>
      </div></div>
      <div class="fc-arrow"></div><div class="fc-arrow"></div>
    </div>

    <div class="fc-phase" style="margin-top:0">4 · Decide</div>
    <div class="fc-step"><div class="fc-tag">S7</div><div>
      <h4>Final gate</h4>
      <p>Combine the two methods' lists: each counts on its own, and agreement shows as the tier.</p>
      <div class="chain"><span class="pill">Method 1 list ∪ Method 2 list</span><span class="to">→</span><span class="pill">Tier by which method lists it</span><span class="to">→</span><span class="pill">{{ cfg.gates.final.min_per_node }}–{{ cfg.gates.final.max_per_node }} per node</span></div>
      <div class="outs"><span class="o ok">Strong (both)</span><span class="o hold">Vector-led (M1) · Gap-led (M2)</span><span class="o">Conditional (fill)</span></div>
      <div class="meta"><span class="k">Output</span>Ranked recommendations per node</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">percentile ranks · Spearman · reciprocal-rank fusion · Dirichlet weight sampling</span></div>
    </div></div>
    <div class="fc-arrow"></div>
    <div class="fc-step"><div class="fc-tag">S8</div><div>
      <h4>Products &amp; sellers</h4>
      <p>Pick varied example products per recommendation, each shown beside its nearest Staples product.</p>
      <div class="chain"><span class="pill">{{ cfg.skus.n_exemplars }} examples per archetype</span><span class="to">→</span><span class="pill">Nearest Staples match</span><span class="to">→</span><span class="pill">{{ cfg.skus.style_extension_n }} style extensions per node</span><span class="to">→</span><span class="pill">Recruit path</span></div>
      <div class="outs"><span class="o ok">Existing Staples supplier</span><span class="o hold">Independent seller</span><span class="o">Competitor house brand</span></div>
      <div class="meta"><span class="k">Output</span>SKU cards, vendor / seller list</div>
      <div class="meta"><span class="k">Tech</span><span class="tech">Maximal Marginal Relevance (MMR) · cosine nearest neighbour</span></div>
    </div></div>
  </div>

  <h2>Archetypes (Attributes Combinations): {{ cfg.archetypes.core_facets }} to {{ cfg.archetypes.max_facets }} attributes, three tiers</h2>
  <div class="card">
    <dl class="lab">
      <dt>Tier 1 · universal</dt><dd>Look and physical facts. <span class="ink2">Examples: material (velvet, faux leather, metal/wire, glass), colour tone (warm-neutral, light-neutral, bold), colour family (brown/wood, black), size (oversized clock, tall lamp).</span></dd>
      <dt>Tier 2 · functional</dt><dd>What the product does, specific to the node. <span class="ink2">Examples: type (barrel chair, writing desk, pod drawer, bento box, wall clock), features (USB port, insulated, leak-proof, drawers, silent movement), size bands (laptop fit 15–16 in, 50+ pods, 6+ panels).</span></dd>
      <dt>Tier 3 · lifestyle</dt><dd>The look and feel. <span class="ink2">Examples: style (mid-century, farmhouse, minimalist), vibe (luxe, statement, cute/kawaii, natural/woven), theme, pattern or audience (nature/animals clock, floral planner, kids' backpack).</span></dd>
    </dl>
    <p class="ink2" style="margin-top:10px"><b>How the attributes are chosen.</b> Candidates are the node's attributes by tier plus up to {{ cfg.archetypes.gap_facets.max_per_node }} <b>gap attributes</b>: credible value gaps in the tags (benefits, use context, audience, aesthetic) where the competitor carries more, turned into yes / not-stated attributes, e.g. “Water-resistant: yes”. Attributes unknown for more than {{ "{:.0%}".format(cfg.archetypes.max_unknown_share) }} of either retailer's products, dominated by one value, or failing validation are left out. Among the rest, the combination of {{ cfg.archetypes.core_facets }} that covers both retailers well <b>and</b> differs most between them (JSD) wins, so archetypes line up with the attribute gaps shown for each node. A combination needs ≥ {{ cfg.archetypes.min_pooled }} families; a node that ends with fewer than {{ cfg.gates.final.min_per_node }} recommendations is re-run with a smaller bar of {{ cfg.archetypes.small_node.min_pooled }} families.</p>
  </div>

  <h2>The two methods</h2>
  <p>Each method keeps its own final score. Neither is blended into the other; they meet only in the final ranking.</p>
  <div class="grid g2">
    <div class="card" style="border-left:3px solid var(--accent)">
      <h3 style="margin-top:0">Method 1 · vector view → {{ m('VOS') }}</h3>
      <p class="ink2">Every product becomes a “card” (same template on both sides: type, colour, material, style, features, vibe, use; no price) and is embedded with <code>{{ encoder }}</code>.</p>
      <dl class="lab">
        <dt>{{ m('VW') }}</dt><dd>How few Staples products sit near this product, after balancing sample sizes.</dd>
        <dt>{{ m('AAS') }}</dt><dd>Fit with Staples: closeness to Staples' catalogue plus overlap with the use contexts Staples serves.</dd>
        <dt>{{ m('CRS') }}</dt><dd>Functional similarity to the nearest Staples products. Ignores price and looks by design.</dd>
        <dt>{{ m('AD') }}</dt><dd>How different the colour, material, style and vibe are from the nearest Staples product.</dd>
        <dt>{{ m('PPR') }}</dt><dd>Price relative to the nearest Staples products. Used only in the labels, never in a score.</dd>
      </dl>
      <p><code>VOS = 100 × [{{ cfg.vector.vos_weights.vw }}·pct(VW) + {{ cfg.vector.vos_weights.aas }}·AAS/100 + {{ cfg.vector.vos_weights.ad }}·pct(AD)] × (1 − CRS/100)</code></p>
    </div>
    <div class="card" style="border-left:3px solid var(--comp)">
      <h3 style="margin-top:0">Method 2 · attribute view → {{ m('TG') }}</h3>
      <p class="ink2">Archetypes (attributes combinations) are compared as shares of each retailer's node, so a sample is compared with a sample, never with a census.</p>
      <dl class="lab">
        <dt>{{ m('LSR') }}</dt><dd>How over-represented the archetype is at the competitor. Defined even when Staples has none; shrunk when not statistically credible.</dd>
        <dt>{{ m('PPG') }}</dt><dd>Distance between the two price distributions inside the archetype (↑ = competitor priced higher).</dd>
        <dt>{{ m('CG') }}</dt><dd>Difference in colour-tone mix.</dd>
        <dt>{{ m('MSG') }}</dt><dd>Difference in material and style mix.</dd>
        <dt>{{ m('DFG') }}</dt><dd>Competitor median DFI minus Staples median DFI.</dd>
        <dt>{{ m('ACR') }}</dt><dd>Method 2's own cannibalisation check: share of the archetype's competitor products that have a Staples <i>attribute twin</i> (same functional attributes, anywhere in the node) and are cheaper (&lt; {{ cfg.gates.method2.undercut_ppr }}×) or the same look at a similar price. Gates only, not part of TG.</dd>
      </dl>
      <p><code>TG = 100 × [{{ cfg.gaps.tg_weights.lsr }}·pct(LSR) + {{ cfg.gaps.tg_weights.ppg }}·pct(PPG) + {{ cfg.gaps.tg_weights.cg }}·pct(CG) + {{ cfg.gaps.tg_weights.msg }}·pct(MSG) + {{ cfg.gaps.tg_weights.dfg }}·pct(DFG)]</code></p>
    </div>
  </div>

  <h3>Decision labels (per competitor product)</h3>
  <div class="tbl-wrap"><table><thead><tr><th class="nosort">Label</th><th class="nosort">Meaning</th><th class="nosort">Action</th><th class="nosort num">Products</th></tr></thead><tbody>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>CURATE</td><td>Low cannibalisation, good fit: true whitespace.</td><td>Approve</td><td class="num">{{ label_counts.get('CURATE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>STYLE-EXTENSION</td><td>Does the same job as a Staples product but in a colour, material or style Staples lacks (the “flavours” case).</td><td>Approve</td><td class="num">{{ label_counts.get('STYLE-EXTENSION',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>TRADE-UP</td><td>Same job, PPR ≥ {{ cfg.vector.ppr_tradeup }}× with a visible upgrade (design or material).</td><td>Approve, margin note</td><td class="num">{{ label_counts.get('TRADE-UP',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>LEAN-APPROVE</td><td>Middle band of CRS, but a clearly different look (AD ≥ {{ cfg.vector.ad_threshold }}) and good fit (AAS ≥ T_high).</td><td>Approve, flag for review</td><td class="num">{{ label_counts.get('LEAN-APPROVE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#eda100"></span>REVIEW</td><td>Middle band of CRS (Cannibalisation Risk Score).</td><td>Calibration queue</td><td class="num">{{ label_counts.get('REVIEW',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#eda100"></span>EDGE</td><td>Low risk, weaker fit with Staples' customer.</td><td>Hold for phase 2</td><td class="num">{{ label_counts.get('EDGE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>SUBSTITUTE</td><td>Same job, same look, similar price: pure diversion.</td><td>Reject</td><td class="num">{{ label_counts.get('SUBSTITUTE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>UNDERCUT</td><td>Same job, PPR below {{ cfg.vector.ppr_undercut }}× the Staples product: resets the price point.</td><td>Hard reject</td><td class="num">{{ label_counts.get('UNDERCUT',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>OFF-BRAND</td><td>Poor fit with Staples' catalogue and customers (low AAS).</td><td>Reject</td><td class="num">{{ label_counts.get('OFF-BRAND',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>EXCLUDE</td><td>Near-identical to a product Staples already carries.</td><td>Not a gap</td><td class="num">{{ label_counts.get('EXCLUDE',0) }}</td></tr>
  </tbody></table></div>

  <p class="muted small">These labels come from Method 1 (vector view). Method 2 labels each product separately from attributes and price only:</p>
  <div class="tbl-wrap"><table><thead><tr><th class="nosort">Method 2 label</th><th class="nosort">Meaning</th><th class="nosort">Counts as</th></tr></thead><tbody>
    <tr><td>Attribute undercut</td><td>A Staples family with the same functional attributes exists, and this product costs &lt; {{ cfg.gates.method2.undercut_ppr }}× its median price.</td><td>Cannibalising</td></tr>
    <tr><td>Attribute substitute</td><td>Same functional attributes, &lt; {{ cfg.gates.method2.tradeup_ppr }}× the price and the same colour tone.</td><td>Cannibalising</td></tr>
    <tr><td>Attribute style-extension</td><td>Same functional attributes and similar price, different look.</td><td>Not cannibalising</td></tr>
    <tr><td>Attribute trade-up</td><td>Same functional attributes, ≥ {{ cfg.gates.method2.tradeup_ppr }}× the price.</td><td>Not cannibalising</td></tr>
    <tr><td>No Staples twin</td><td>No Staples family with the same function in the node: whitespace by attributes.</td><td>Not cannibalising</td></tr>
  </tbody></table></div>

  <h3>From two scores to one list</h3>
  <ol class="steps">
    <li><b>Common gates.</b> Every competitor product must belong on the node (C1), and every archetype must be valid: ≥ {{ cfg.archetypes.core_facets }} attributes, nameable, ≥ {{ cfg.gates.common.min_competitor_families }} competitor families (C2).</li>
    <li><b>Method 1 gate (vector view, its own cannibalisation check).</b> ≥ {{ cfg.gates.method1.min_safe_products }} products safe under Method 1's labels, a safe share of ≥ {{ "{:.0%}".format(cfg.gates.method1.min_safe_share) }} of decided (non-REVIEW) products, and fewer than {{ "{:.0%}".format(cfg.gates.method1.max_reject_share) }} substitutes + undercuts. The top {{ cfg.gates.method1.top_n }} per node by VOS form the Method 1 list.</li>
    <li><b>Method 2 gate (attribute view, its own cannibalisation check).</b> The competitor credibly over-indexes (LSR credibility ≥ {{ "{:.0%}".format(cfg.gates.method2.min_credibility) }}, or Staples has none), ACR (Attribute Cannibalisation Risk) &lt; {{ "{:.0%}".format(cfg.gates.method2.max_acr) }}, and ≥ {{ cfg.gates.method2.min_ok_products }} non-cannibalising products. The top {{ cfg.gates.method2.top_n }} per node by TG form the Method 2 list.</li>
    <li><b>Final gate.</b> The union of the two lists. Tier = which method lists the archetype:
      <ul>
        <li><i>Strong</i>: on both lists.</li>
        <li><i>Vector-led</i>: Method 1 only (whitespace in the vector view that passes Method 1's checks).</li>
        <li><i>Gap-led</i>: Method 2 only (a credible attribute gap with few cheaper or same-look Staples twins; check fit with Staples' customer).</li>
        <li><i>Conditional</i>: added only when a node has fewer than {{ cfg.gates.final.min_per_node }}; best remaining valid archetypes with a product safe under either method.</li>
      </ul>
      Order: Strong first, then <code>Final = {{ cfg.integration.w_vos }}·rank(VOS) + {{ cfg.integration.w_tg }}·rank(TG)</code>. {{ cfg.gates.final.min_per_node }}–{{ cfg.gates.final.max_per_node }} recommendations per node.</li>
    <li><b>Products shown.</b> Only products safe under the method(s) that recommended the archetype: Method 1 labels for Vector-led, no cheaper or same-look Staples attribute twin for Gap-led, both for Strong.</li>
    <li><b>Robustness check.</b> Both sets of weights are re-drawn {{ "{:,}".format(cfg.sensitivity.draws) }} times; the report shows how often each archetype stays in its node's top {{ cfg.sensitivity.top_n }}.</li>
  </ol>

  <h2>Safety gates: the filters that decide recommendations</h2>
  <p class="ink2">Common gates up to the archetypes, then one gate per method on that method's own scores, then the final gate. Counts are for this run, all nodes together.</p>
  <div class="tbl-wrap"><table class="grouped"><thead><tr><th class="nosort">Gate</th><th class="nosort">What is checked</th><th class="nosort">Result</th><th class="nosort">Target (rule)</th><th class="nosort">Status</th><th class="nosort">Note (stage · code)</th></tr></thead>
  {% for grp in safety_gates|map(attribute='group')|unique %}<tbody><tr><td colspan="6" class="grp">{{ grp }}</td></tr>
  {% for g in safety_gates if g.group == grp %}<tr><td><b>{{ g.name }}</b></td><td>{{ g.metric }}</td><td>{{ g.value }}</td><td>{{ g.target }}</td><td><span class="chip st-{{ g.status }}">{{ g.status }}</span></td><td class="ink2">{{ g.note }}</td></tr>{% endfor %}</tbody>{% endfor %}
  </table></div>
  <p class="muted small">FILTER = removes items · PICK = selects from what is left. CRS = Cannibalisation Risk Score · AAS = Adjacency Affinity Score · PPR = Price Position Ratio · AD = Aesthetic Delta · LSR = Log Share Ratio · ACR = Attribute Cannibalisation Risk · VOS = Vector Opportunity Score · TG = Total Gap.</p>

  <h2>Quality gates: a scorecard, cuts nothing</h2>
  <p class="ink2">Checks on how trustworthy each step of the method is. They report PASS / FAIL / PENDING and do not remove any product or recommendation (G2 only keeps inaccurate fields out of the gap scores).</p>
  <div class="tbl-wrap"><table><thead><tr><th class="nosort">Gate</th><th class="nosort">What is checked</th><th class="nosort">Result</th><th class="nosort">Target</th><th class="nosort">Status</th><th class="nosort">Note</th></tr></thead><tbody>
  {% for g in gates %}<tr><td><b>{{ g.name }}</b></td><td>{{ g.metric }}</td><td>{{ g.value }}</td><td style="white-space:nowrap">{{ g.target }}</td><td><span class="chip st-{{ g.status }}">{{ g.status }}</span></td><td class="ink2">{{ g.note }}</td></tr>{% endfor %}
  </tbody></table></div>
  <details><summary>Encoder bake-off and calibration</summary>
    <div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th class="nosort">Encoder</th><th class="nosort num">Staples leave-one-out node k-NN</th><th class="nosort num">In-scope kept</th><th class="nosort num">Out-of-scope rejected</th><th class="nosort num">NONE threshold</th></tr></thead><tbody>
    {% for b in bakeoff %}<tr><td>{{ b.model }}{% if b.model == encoder %} <span class="chip st-PASS">chosen</span>{% endif %}</td><td class="num">{{ "{:.1%}".format(b.staples_loo_knn) }}</td><td class="num">{{ "{:.1%}".format(b.in_scope_recall) }}</td><td class="num">{{ "{:.1%}".format(b.out_scope_rejection) }}</td><td class="num">{{ "%.3f"|format(b.tau_none) }}</td></tr>{% endfor %}
    </tbody></table></div>
    <div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th class="nosort">Peer group (L2)</th><th class="nosort">CRS (Cannibalisation Risk Score) calibration</th><th class="nosort num">AUC (Area Under the ROC Curve)</th><th class="nosort num">AAS (Adjacency Affinity Score) low / high</th></tr></thead><tbody>
    {% for l2, c in calib.items() %}<tr><td>{{ l2 }}</td><td>{{ c.method }} ({{ c.n_pos }} positive, {{ c.n_neg }} negative Staples pairs)</td><td class="num">{{ "%.2f"|format(c.auc) if c.auc is not none else "–" }}</td><td class="num">{{ "%.0f"|format(thresholds[l2].aas_low) }} / {{ "%.0f"|format(thresholds[l2].aas_high) }}</td></tr>{% endfor %}
    </tbody></table></div>
  </details>

  <h2>Assumptions and caveats</h2>
  <ul>
    <li><b>Provisional PoC run.</b> Attributes come from the local rules + embedding extractor (no LLM key available); style, vibe, theme tags and the DFI (Design-Forward Index) still need human validation; thresholds are weakly supervised, not yet calibrated with the business. Node vocabularies are drafts awaiting review.</li>
    <li>Only the agreed product columns are used (title, price, link, brand/vendor, selected option, description and listing page). Ratings, review counts, ranks, badges and specification columns are not used, so nothing here measures demand.</li>
    <li>Competitor data are convenience samples (pages that scraped successfully). Every number is a within-sample share with a credibility check; nothing here estimates market size.</li>
    <li>Competitor descriptions differ in length (from a one-line subtitle to long prose). Text-measured attributes read the same amount of Staples text as the competitor provides, so “not mentioned” means the same on both sides.</li>
    <li>Everything Staples.com sells counts as existing assortment for cannibalisation, including third-party brands it retails.</li>
    <li>A competitor's brand/vendor is often a house brand or missing: those products are recommendations to <i>source the archetype</i>, not to recruit that brand.</li>
  </ul>
</section>

<!-- ======================================================= TAB 2 -->
<section class="panel" id="tab-nodes" hidden>
  <div class="controls">
    <label for="nodeSel">Node</label>
    <select id="nodeSel">
      {% for l1 in nodes|map(attribute='l1')|unique %}<optgroup label="{{ l1 }}">
        {% for n in nodes if n.l1 == l1 %}<option value="{{ n.id }}">{{ n.label }}{% if n.status != 'scored' %} ({{ n.status_label }}){% endif %}</option>{% endfor %}
      </optgroup>{% endfor %}
    </select>
  </div>

  {% for s in sections %}
  <article class="node-sec" id="n-{{ s.id }}" hidden>
    <div class="node-head">
      <h2>{{ s.label }}</h2>
      {% if s.status == 'thin' %}<span class="chip st-PENDING">thin node: descriptive only</span>{% endif %}
      {% if s.status == 'staples_only' %}<span class="chip st-PARTIAL">competitor data pending</span>{% endif %}
    </div>
    <dl class="facts">
      <dt>Segment · play</dt><dd>{{ s.segment or "–" }}</dd>
      {% if s.status == 'staples_only' %}
      <dt>Competitor planned</dt><dd><b class="compname">{{ s.planned }}</b> <span class="muted">(no product data yet)</span></dd>
      <dt>Product families</dt><dd>Staples {{ "{:,}".format(s.ns) }}</dd>
      {% else %}
      <dt>Competitor</dt><dd><b class="compname">{{ s.comp }}</b> <span class="muted">(Primary 1)</span></dd>
      <dt>Product families</dt><dd>Staples {{ "{:,}".format(s.ns) }} · {{ s.comp }} {{ "{:,}".format(s.nc) }}</dd>
      <dt>Mapping confidence</dt><dd>{{ "{:.0%}".format(s.highconf) }} of mapped {{ s.comp }} products placed with high confidence{% if s.backlog %}; {{ s.backlog }} products from this node's pages set aside as mis-shelved or out of scope{% endif %}</dd>
      {% if s.facets %}<dt>Archetype (Attributes Combination) definition</dt><dd>{{ s.facets }}</dd>
      <dt>Archetypes (Attributes Combinations)</dt><dd>{{ s.n_arch }} archetypes{% if s.tail is not none %}; {{ "{:.0%}".format(s.tail) }} of families in the long tail (in no supported combination){% endif %}</dd>{% endif %}
      {% endif %}
    </dl>

    {% if s.status == 'staples_only' %}
    <div class="pending">No {{ s.planned }} product data for this node yet, so gaps and recommendations cannot be scored. The Staples side is profiled below; the node runs in full as soon as competitor data is added, with no code change.</div>
    <h3>Staples profile</h3>
    <p class="ink2">Median Staples price {{ s.price_median }}. Price bands: {% for b in s.bands %}{{ b.band }} {{ b.share }}{% if not loop.last %} · {% endif %}{% endfor %}.</p>
    <div class="tbl-wrap"><table><thead><tr><th class="nosort">Attribute</th><th class="nosort num">Known</th><th class="nosort">Most common values (share of families where known)</th></tr></thead><tbody>
    {% for r in s.profile %}<tr><td class="key">{{ r.attr }}</td><td class="num">{{ r.known }}</td><td>{{ r.top }}</td></tr>{% endfor %}
    </tbody></table></div>
    {% else %}

    <h3>Key insights</h3>
    <div class="card"><dl class="insg">{% for g in s.insights %}
      <dt>{{ g.group }}</dt><dd><ul class="ins">{% for i in g.lines %}<li>{{ i }}</li>{% endfor %}</ul></dd>{% endfor %}
    </dl></div>

    <h3>Coverage</h3>
    <div class="grid g2">
      {% if s.figs.price %}<figure class="fig"><img alt="Price-band coverage" src="{{ s.figs.price }}"><figcaption>Share of each retailer's families per price band. “gap” = {{ s.comp }} share credibly higher.</figcaption></figure>{% endif %}
      <figure class="fig"><img alt="Design-forward distribution" src="{{ s.figs.dfi }}"><figcaption>DFI (Design-Forward Index), pooled percentile of a design-vs-utility contrast (provisional until human validation).</figcaption></figure>
      {% if s.figs.jsd %}<figure class="fig"><img alt="Attribute divergence" src="{{ s.figs.jsd }}"><figcaption>JSD (Jensen–Shannon Divergence): higher = the two retailers' mixes differ more on that attribute.</figcaption></figure>{% endif %}
      {% if s.figs.gaps %}<figure class="fig"><img alt="Attribute value gaps" src="{{ s.figs.gaps }}"><figcaption>Credible gaps only (≥ 90% posterior probability); fields that failed validation are excluded.</figcaption></figure>{% endif %}
    </div>

    <details class="sec"><summary><h3>Attribute level gaps (detailed):</h3><span class="hint">click to expand</span></summary>
    <div class="tbl-wrap" style="margin-top:8px"><table class="grouped"><thead><tr><th class="nosort">Tier</th><th class="nosort">Attribute</th><th class="nosort">Value</th><th class="nosort num">{{ s.comp }}</th><th class="nosort num">Staples</th><th class="nosort num">Gap</th><th class="nosort num">Credibility</th></tr></thead>
    {% for g in s.gaps %}<tbody>{% for r in g.rows %}<tr>{% if loop.first %}<td rowspan="{{ g.rows|length }}" class="grp">{{ g.tier }}</td><td rowspan="{{ g.rows|length }}" class="grp">{{ g.attr }}{% if g.desc %}<br><span class="chip">descriptive only</span>{% endif %}</td>{% endif %}<td>{{ r.val }}</td><td class="num">{{ r.sc }}</td><td class="num">{{ r.ss }}</td><td class="num {{ 'pos' if r.pos else 'neg' }}">{{ r.delta }}</td><td class="num">{{ r.cred }}</td></tr>{% endfor %}</tbody>
    {% else %}<tbody><tr><td colspan="7" class="muted">No credible attribute-value gaps.</td></tr></tbody>{% endfor %}
    </table></div>
    <p class="muted" style="font-size:12px">Share of families where the attribute is known. Ordered by tier, then by each attribute's largest gap; values by gap ({{ s.comp }} deeper first). Credibility = posterior probability that {{ s.comp }}'s share is higher; values near 0% mean Staples is credibly deeper.</p>
    </details>

    {% if s.status == 'scored' %}
    <h3>Final recommendations</h3>
    <div class="lede"><ul class="agree">
      <li><b>Method agreement score: {% if s.rho is not none %}{{ "%.2f"|format(s.rho) }}{% else %}–{% endif %}</b> <span class="ink2">(Spearman correlation coefficient, VOS (Vector Opportunity Score) vs TG (Total Gap))</span></li>
      <li>{{ s.rho_note }}</li>
    </ul></div>
    <div class="tbl-wrap" style="margin-top:10px"><table class="sortable"><thead><tr><th class="num">Rank</th><th>Archetype (Attributes Combination)</th><th>Tier</th><th class="num">Final score</th><th class="num">VOS (Vector Opportunity Score)</th><th class="num">TG (Total Gap)</th><th class="num">Staples / {{ s.comp }} families</th></tr></thead><tbody>
    {% for r in s.final %}<tr><td class="num">{{ r.rank }}</td><td>{{ A(r.a, True) }}</td><td>{% if r.tier == 'Strong' %}<span class="chip st-PASS">Strong</span>{% elif r.tier == 'Conditional' %}<span class="chip st-PARTIAL">Conditional</span>{% else %}<span class="chip">{{ r.tier }}</span>{% endif %}</td><td class="num">{{ r.final }}</td><td class="num">{{ r.vos }}</td><td class="num">{{ r.tg }}</td><td class="num">{{ r.ns }} / {{ r.nc }}</td></tr>
    {% else %}<tr><td colspan="7" class="muted">No archetype passed either method's safety gate.</td></tr>{% endfor %}
    </tbody></table></div>
    <div class="grid g2" style="margin-top:10px">
      {% if s.figs.agreement %}<figure class="fig"><img alt="TG versus VOS" src="{{ s.figs.agreement }}"><figcaption>#n = recommended, by final order. Colour = tier; hollow = not recommended.</figcaption></figure>{% endif %}
    </div>

    <h3>SKU recommendations</h3>
    {% for g in s.skus %}<div class="skugrp">
      <b>#{{ g.rank }} · {{ g.a.name }}</b> <span class="combo">({{ g.a.combo }})</span> <span class="chip">{{ g.tier }}</span>
      {% for c in g.cards %}{% include 'card.html.j2' %}{% endfor %}
    </div>{% else %}<p class="muted">No shortlisted archetype on this node.</p>{% endfor %}

    {% if s.style_ext %}<h4>Style extensions: {{ s.style_ext|length }} colour, material or style variants of existing Staples products</h4>
      {% for c in s.style_ext %}{% include 'card.html.j2' %}{% endfor %}
    {% endif %}

    <h3>Vendor / seller view</h3>
    <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Display brand</th><th class="num">Approvable products</th><th class="num">Archetypes (Attributes Combinations)</th><th>Recruit path</th></tr></thead><tbody>
    {% for v in s.vendors %}<tr><td>{{ v.brand }}{% if v.on %} <span class="chip st-PASS">sells on Staples</span>{% endif %}{% if v.house %} <span class="chip">{{ s.comp }} house brand</span>{% endif %}</td><td class="num">{{ v.products }}</td><td class="num">{{ v.arch }}</td><td class="ink2">{{ v.path }}</td></tr>
    {% else %}<tr><td colspan="4" class="muted">No approvable products in recommended archetypes.</td></tr>{% endfor %}
    </tbody></table></div>

    <details class="sec"><summary><h3>Excluded archetypes (attributes combinations) ({{ s.excluded|length }})</h3><span class="hint">click to expand</span></summary>
    <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Archetype (Attributes Combination)</th><th>Why excluded</th><th>Agreement</th><th class="num">VOS (Vector Opportunity Score)</th><th class="num">TG (Total Gap)</th></tr></thead><tbody>
    {% for r in s.excluded %}<tr><td>{{ A(r.a, False) }}</td><td class="ink2">{{ r.reason }}</td><td>{{ r.tier }}</td><td class="num">{{ r.vos }}</td><td class="num">{{ r.tg }}</td></tr>
    {% else %}<tr><td colspan="5" class="muted">None: every archetype passed the safety gate.</td></tr>{% endfor %}
    </tbody></table></div>
    </details>

    <details class="sec"><summary><h3>Method 1: Vector view results</h3><span class="hint">click to expand</span></summary>
    <p class="ink2">Every archetype (attributes combination) on this node, highest VOS (Vector Opportunity Score) first. VOS rewards whitespace (VW), fit with Staples (AAS) and a visibly different look (AD), then is reduced by cannibalisation risk (CRS). Faded bars failed the Method 1 gate; the M1 gate column gives the reason.</p>
    <div class="grid g2">
      {% if s.figs.vos %}<figure class="fig"><img alt="VOS by archetype" src="{{ s.figs.vos }}"><figcaption>Bar segments = what VW (Vector Whitespace), AAS (Adjacency Affinity Score) and AD (Aesthetic Delta) contribute after the CRS (Cannibalisation Risk Score) discount; the number in brackets is the score before that discount.</figcaption></figure>{% endif %}
      {% if s.figs.decision %}<figure class="fig"><img alt="Decision scatter" src="{{ s.figs.decision }}"><figcaption>Every {{ s.comp }} product on this node; lines = CRS {{ cfg.vector.crs_low }}/{{ cfg.vector.crs_high }} and AAS thresholds.</figcaption></figure>{% endif %}
    </div>
    <div class="tbl-wrap" style="margin-top:10px"><table class="sortable"><thead><tr><th>Archetype (Attributes Combination)</th><th class="num">VOS (Vector Opportunity Score)</th><th class="num">Staples</th><th class="num">{{ s.comp }}</th><th class="num">VW (Vector Whitespace)</th><th class="num">AAS (Adjacency Affinity Score)</th><th class="num">AD (Aesthetic Delta)</th><th class="num">CRS (Cannibalisation Risk Score)</th><th class="num">PPR (Price Position Ratio)</th><th class="num">Safe products</th><th class="num">Safe share (of decided)</th><th class="num">Substitute + undercut</th><th>M1 gate</th><th>Reason</th></tr></thead><tbody>
    {% for r in s.m1 %}<tr><td>{{ A(r.a, False) }}</td><td class="num"><b>{{ r.vos }}</b></td><td class="num">{{ r.ns }}</td><td class="num">{{ r.nc }}</td><td class="num">{{ r.vw }}</td><td class="num">{{ r.aas }}</td><td class="num">{{ r.ad }}</td><td class="num">{{ r.crs }}</td><td class="num">{{ r.ppr }}</td><td class="num">{{ r.nsafe }}</td><td class="num">{{ r.safe }}</td><td class="num">{{ r.rej }}</td><td>{% if r.listed %}<span class="chip st-PASS">listed</span>{% else %}{{ r.elig }}{% endif %}</td><td class="ink2">{{ r.why }}</td></tr>{% endfor %}
    </tbody></table></div>
    </details>

    <details class="sec"><summary><h3>Method 2: Attribute view results</h3><span class="hint">click to expand</span></summary>
    <p class="ink2">Every archetype (attributes combination) on this node, highest TG (Total Gap) first. TG measures how far {{ s.comp }} over-indexes on the archetype (LSR) and how different its price (PPG), colour (CG), material/style (MSG) and design-forward (DFG) mix is.</p>
    {% if s.figs.tg %}<figure class="fig solo"><img alt="TG by archetype" src="{{ s.figs.tg }}"><figcaption>Bar segments = weighted contribution of each gap metric (percentile within the peer group). Faded = failed the safety gate.</figcaption></figure>{% endif %}
    <div class="tbl-wrap" style="margin-top:10px"><table class="sortable"><thead><tr><th>Archetype (Attributes Combination)</th><th class="num">TG (Total Gap)</th><th class="num">Staples share</th><th class="num">{{ s.comp }} share</th><th class="num">LSR (Log Share Ratio)</th><th class="num">Credibility</th><th>Flag</th><th class="num">PPG (Price Position Gap)</th><th class="num">CG (Colour Gap)</th><th class="num">MSG (Material &amp; Style Gap)</th><th class="num">DFG (Design-Forward Gap)</th><th class="num">TG (original weights)</th><th class="num">ACR (Attribute Cannibalisation Risk)</th><th class="num">Non-cannibalising products</th><th>M2 gate</th><th>Reason</th><th>Colours Staples lacks</th></tr></thead><tbody>
    {% for r in s.m2 %}<tr><td>{{ A(r.a, False) }}</td><td class="num"><b>{{ r.tg }}</b></td><td class="num">{{ r.ps }}</td><td class="num">{{ r.pc }}</td><td class="num">{{ r.lsr }}</td><td class="num">{{ r.cred }}</td><td>{{ r.flag }}</td><td class="num">{{ r.ppg }}</td><td class="num">{{ r.cg }}</td><td class="num">{{ r.msg }}</td><td class="num">{{ r.dfg }}</td><td class="num">{{ r.tgo }}</td><td class="num">{{ r.acr }}</td><td class="num">{{ r.nok }}</td><td>{% if r.listed %}<span class="chip st-PASS">listed</span>{% else %}{{ r.elig }}{% endif %}</td><td class="ink2">{{ r.why }}</td><td class="ink2">{{ r.miss }}</td></tr>{% endfor %}
    </tbody></table></div>
    </details>
    {% else %}
    <p class="muted">Fewer than {{ cfg.nodes.min_families_scored }} families on one side: shown descriptively; archetypes and recommendations are not scored for this node.</p>
    {% endif %}
    {% endif %}

    {% if s.acc_img %}<details><summary>Extraction accuracy on this node (text extractor vs Staples specs{% if s.parity %}, Staples text cut to {{ s.parity }} characters{% endif %})</summary>
      <figure class="fig solo" style="margin-top:8px"><img alt="Extractor accuracy" src="{{ s.acc_img }}"></figure>
    </details>{% endif %}
  </article>
  {% endfor %}
</section>

<footer>Staples Marketplace assortment PoC · LatentView · generated {{ date }} · method: methodology.md v1.3 (Phase 2) · encoder {{ encoder }} · extraction backend: {{ backend }}.</footer>
</div></main>

<script>
(function(){
  var tabs=document.querySelectorAll('nav.tabs button');
  function openTab(name){
    tabs.forEach(function(b){b.setAttribute('aria-selected', b.dataset.tab===name ? 'true':'false');});
    document.getElementById('tab-method').hidden = name!=='method';
    document.getElementById('tab-nodes').hidden = name!=='nodes';
    try{localStorage.setItem('alpoc-tab',name);}catch(e){}
  }
  tabs.forEach(function(b){b.addEventListener('click',function(){openTab(b.dataset.tab);});});
  var sel=document.getElementById('nodeSel');
  function showNode(id){
    document.querySelectorAll('.node-sec').forEach(function(s){s.hidden = s.id!=='n-'+id;});
    if(sel.value!==id) sel.value=id;
    try{localStorage.setItem('alpoc-node',id); history.replaceState(null,'','#'+id);}catch(e){}
  }
  sel.addEventListener('change',function(){showNode(sel.value);});
  var start=(location.hash||'').slice(1), tab=null, node=null;
  try{tab=localStorage.getItem('alpoc-tab'); node=localStorage.getItem('alpoc-node');}catch(e){}
  if(start && document.getElementById('n-'+start)){node=start; tab='nodes';}
  if(!node || !document.getElementById('n-'+node)) node=sel.options[0] ? sel.options[0].value : null;
  if(node) showNode(node);
  openTab(tab==='nodes' ? 'nodes' : 'method');
  // sortable tables
  document.querySelectorAll('table.sortable th').forEach(function(th){
    th.addEventListener('click',function(){
      var table=th.closest('table'), idx=Array.prototype.indexOf.call(th.parentNode.children,th);
      var body=table.tBodies[0], rows=Array.prototype.slice.call(body.rows);
      var asc = th.dataset.dir!=='asc'; th.dataset.dir = asc ? 'asc':'desc';
      function val(r){var t=(r.cells[idx]||{}).textContent||''; var n=parseFloat(t.replace(/[$,%+↑↓ ]/g,'')); return isNaN(n)? t.toLowerCase(): n;}
      rows.sort(function(a,b){var x=val(a),y=val(b); if(x===y) return 0; return (x>y?1:-1)*(asc?1:-1);});
      rows.forEach(function(r){body.appendChild(r);});
    });
  });
})();
</script>
</body>
</html>
